{
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "local-install": "npm install && packageJsonVersion=$(grep '\"version\"' package.json | head -1 | sed -E 's/.*\\\"version\\\": *\\\"([^\\\"]+)\\\".*/\\1/') && vsce package && code --install-extension ohmyguid-$packageJsonVersion.vsix"
  },
  "name": "ohmyguid",
  "displayName": "OhMyGuid",
  "description": "Azure and Microsoft Entra ID guids look up",
  "version": "0.0.44",
  "engines": {
    "vscode": "^1.103.0"
  },
  "icon": "images/icon.png",
  "publisher": "expecting-snow",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/expecting-snow/ohmyguid.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:bicep",
    "onLanguage:json",
    "onLanguage:markdown",
    "onLanguage:powershell",
    "onLanguage:shellscript",
    "onLanguage:yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ohmyguid.refresh",
        "title": "Refresh",
        "category": "OhMyGuid"
      },
      {
        "command": "ohmyguid.lookup",
        "title": "LookUp",
        "category": "OhMyGuid"
      },
      {
        "command": "ohmyguid.lookupUserPrincipalName",
        "title": "LookUp User",
        "category": "OhMyGuid"
      },
      {
        "command": "ohmyguid.info",
        "title": "Info",
        "category": "OhMyGuid"
      },
      {
        "command": "ohmyguid.preLoad",
        "title": "PreLoad",
        "category": "OhMyGuid"
      }
    ],
    "codeLens": [
      {
        "language": "yaml",
        "pattern": "**/*.y?(a)ml"
      },
      {
        "language": "bicep",
        "pattern": "**/*.bicep"
      },
      {
        "language": "markdown",
        "pattern": "**/*.md"
      },
      {
        "language": "json",
        "pattern": "**/*.json"
      },
      {
        "language": "shellscript",
        "pattern": "**/*.sh"
      },
      {
        "language": "powershell",
        "pattern": "**/*.ps1"
      }
    ]
  },
  "devDependencies": {
    "@azure/arm-authorization": "9.0.0",
    "@azure/arm-managementgroups": "2.0.2",
    "@azure/arm-policy": "6.0.0",
    "@azure/arm-resourcegraph": "4.2.1",
    "@azure/arm-resources": "7.0.0",
    "@azure/arm-resources-subscriptions": "^2.1.0",
    "@azure/identity": "4.13.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@microsoft/microsoft-graph-types": "2.43.1",
    "@types/mocha": "10.0.10",
    "@types/node": "25.0.8",
    "@types/vscode": "1.103.0",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "2.5.2",
    "async-mutex": "0.5.0",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "jwt-decode": "4.0.0",
    "typescript": "5.9.3"
  }
}
